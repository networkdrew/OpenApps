---
import type { GetStaticPaths } from "astro";
import { apps, getComponentId } from "@/lib/apps/registry";
import { SITE_URL } from "@/lib/config/site";
import type { AppMeta } from "@/lib/apps/schema";
import AppWorkspaceLayout from "@/layouts/AppWorkspaceLayout.astro";
import AppIslandLoader from "@/components/react/AppIslandLoader";

// Apps that live at their own permanent top-level route (see
// src/pages/notes/index.astro and src/pages/budget/index.astro) instead of
// the default /apps/<slug>/ page. astro.config.mjs redirects /apps/<slug>
// to that route so every existing link (cards, search, sitemap) still
// resolves.
export const getStaticPaths: GetStaticPaths = () =>
  apps
    .filter((app) => app.id !== "notes" && app.id !== "budget")
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));

interface Props {
  app: AppMeta;
}

const { app } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name,
  description: app.seo.description ?? app.shortDescription,
  url: `${SITE_URL}/apps/${app.slug}/`,
  applicationCategory: "WebApplication",
  operatingSystem: "Any (runs in a web browser)",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<AppWorkspaceLayout app={app} structuredData={structuredData}>
  <AppIslandLoader componentId={getComponentId(app)} client:load />
</AppWorkspaceLayout>
