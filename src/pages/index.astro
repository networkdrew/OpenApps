---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  NAV_LINKS,
} from "@/lib/config/site";
import { apps } from "@/lib/apps/registry";
import { ThemeToggle } from "@/components/react/ThemeToggle";
import { Clock } from "@/components/react/Clock";
import { DesktopDock } from "@/components/react/DesktopDock";
import AppIcon from "@/components/astro/AppIcon.astro";
import Icon from "@/components/astro/Icon.astro";

const allApps = [...apps];
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} path="/" desktop>
  <div class="desktop-wallpaper" aria-hidden="true"></div>

  <header
    class="border-border bg-bg/70 relative z-40 border-b backdrop-blur-md"
  >
    <div class="flex items-center gap-4 px-4 py-2 sm:px-6">
      <a href="/" class="text-text flex items-center gap-2 text-sm font-bold">
        <span
          class="bg-accent text-accent-contrast flex h-5 w-5 items-center justify-center rounded-[22%]"
          aria-hidden="true"
        >
          <Icon name="layout-grid" class="h-3.5 w-3.5" />
        </span>
        {SITE_NAME}
      </a>

      <nav aria-label="Primary" class="flex items-center gap-1">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="text-text-muted hover:bg-bg-sunken hover:text-text rounded-md px-2 py-1 text-sm font-medium transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto flex items-center gap-2">
        <Clock client:load />
        <ThemeToggle client:only="react" />
      </div>
    </div>
  </header>

  <div class="desktop-area relative z-10 h-[calc(100svh-2.5rem)]">
    <div class="mx-auto max-w-3xl px-6 pt-10 text-center sm:pt-16">
      <h1 class="text-text text-3xl font-extrabold tracking-tight sm:text-4xl">
        {SITE_TAGLINE}
      </h1>
      <p class="text-text-muted mx-auto mt-3 max-w-xl text-sm">
        Pick an app to open it. No accounts, no tracking, nothing to download —
        everything runs in your browser and your data stays on your device.
      </p>
    </div>

    <div
      class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-4 px-6 sm:grid-cols-3 sm:gap-6"
    >
      {
        allApps.map((app) => (
          <a
            href={`/${app.slug}/`}
            class="group flex flex-col items-center gap-2"
          >
            <span class="transition-transform duration-150 ease-out group-hover:-translate-y-1 group-hover:scale-105">
              <AppIcon app={app} class="h-20 w-20 sm:h-24 sm:w-24" />
            </span>
            <span class="desktop-label text-text text-sm font-medium">
              {app.name}
            </span>
          </a>
        ))
      }
    </div>

    <p class="text-text-muted mx-auto mt-8 pb-32 text-center text-xs">
      Tip: press <kbd
        class="border-border text-text rounded border px-1.5 py-0.5">Ctrl</kbd
      >
      <kbd class="border-border text-text rounded border px-1.5 py-0.5">K</kbd>{
        " "
      }
      anywhere to search.
    </p>
  </div>

  <DesktopDock apps={allApps} client:load />
</BaseLayout>

<style>
  .desktop-wallpaper {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(
        120% 90% at 15% 0%,
        color-mix(in srgb, var(--color-accent) 16%, transparent),
        transparent 60%
      ),
      radial-gradient(
        110% 90% at 100% 100%,
        color-mix(in srgb, #6366f1 18%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 80% at 85% 10%,
        color-mix(in srgb, #10b981 12%, transparent),
        transparent 50%
      ),
      var(--color-bg);
  }

  .desktop-area {
    overflow-y: auto;
  }

  .desktop-label {
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
  }
</style>
