---
import type { GetStaticPaths } from "astro";
import { apps, getComponentId } from "@/lib/apps/registry";
import { SITE_URL } from "@/lib/config/site";
import type { AppMeta } from "@/lib/apps/schema";
import AppWorkspaceLayout from "@/layouts/AppWorkspaceLayout.astro";
import AppIslandLoader from "@/components/react/AppIslandLoader";

// Apps that live at their own permanent top-level route with extra
// surrounding content (see src/pages/notes/index.astro and
// src/pages/budget/index.astro) are excluded here so this dynamic route
// doesn't collide with those static ones. Every other app is served
// directly from this file at /<slug>/ — see docs/architecture.md's "URL
// structure" note.
export const getStaticPaths: GetStaticPaths = () =>
  apps
    .filter((app) => app.id !== "notes" && app.id !== "budget")
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));

interface Props {
  app: AppMeta;
}

const { app } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name,
  description: app.seo.description ?? app.shortDescription,
  url: `${SITE_URL}/${app.slug}/`,
  applicationCategory: "WebApplication",
  operatingSystem: "Any (runs in a web browser)",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<AppWorkspaceLayout app={app} structuredData={structuredData}>
  <AppIslandLoader componentId={getComponentId(app)} client:load />
</AppWorkspaceLayout>
