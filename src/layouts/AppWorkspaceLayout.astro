---
import type { AppMeta } from "@/lib/apps/schema";
import { getCategory } from "@/lib/apps/categories";
import { getRelatedApps } from "@/lib/apps/registry";
import BaseLayout from "./BaseLayout.astro";
import PrivacyBadge from "@/components/astro/PrivacyBadge.astro";
import RelatedApps from "@/components/astro/RelatedApps.astro";
import Icon from "@/components/astro/Icon.astro";
import AppShell, {
  APP_INFO_DIALOG_ID,
} from "@/components/react/app-shell/AppShell";

interface Props {
  app: AppMeta;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Overrides the canonical path — only needed for an app with extra
   *  surrounding page content at its top-level route (e.g. notes, budget)
   *  instead of the default bare /<slug>/ page. */
  path?: string;
}

const { app, structuredData, path = `/${app.slug}/` } = Astro.props;
const category = getCategory(app.categoryId);
const related = getRelatedApps(app);
---

<BaseLayout
  title={app.name}
  description={app.seo.description ?? app.shortDescription}
  path={path}
  structuredData={structuredData}
  shell
>
  <AppShell
    client:load
    app={{
      name: app.name,
      categoryId: app.categoryId,
      offlineCapable: app.offlineCapable,
    }}
  >
    <slot />
  </AppShell>

  <dialog
    id={APP_INFO_DIALOG_ID}
    aria-labelledby="app-info-title"
    class="app-info-dialog border-border bg-bg-elevated text-text w-full max-w-lg rounded-xl border p-0 shadow-2xl backdrop:bg-black/40"
  >
    <div class="flex max-h-[85vh] flex-col gap-5 overflow-y-auto p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <div>
          <nav aria-label="Breadcrumb" class="text-text-muted mb-1 text-xs">
            <a href="/apps/" class="hover:text-text hover:underline">All apps</a
            >
            {
              category && (
                <>
                  {" "}
                  /{" "}
                  <a
                    href={`/categories/${category.id}/`}
                    class="hover:text-text hover:underline"
                  >
                    {category.name}
                  </a>
                </>
              )
            }
          </nav>
          <h2 id="app-info-title" class="text-text text-xl font-bold">
            {app.name}
          </h2>
        </div>
        <form method="dialog">
          <button
            type="submit"
            aria-label="Close"
            class="text-text-muted hover:bg-bg-sunken hover:text-text inline-flex h-8 w-8 items-center justify-center rounded-md"
          >
            <Icon name="x" class="h-4 w-4" />
          </button>
        </form>
      </div>

      <div class="text-text-muted flex flex-col gap-3 text-sm">
        {app.description.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {
        app.replacesProducts.length > 0 && (
          <p class="text-text-muted text-sm">
            A free alternative to{" "}
            <span class="text-text font-medium">
              {app.replacesProducts.join(", ")}
            </span>
            .
          </p>
        )
      }

      <PrivacyBadge
        privacy={app.privacy}
        offlineCapable={app.offlineCapable}
        offlineNotes={app.offlineNotes}
      />

      {
        app.usageNotes.length > 0 && (
          <div>
            <h3 class="text-text-muted text-sm font-semibold tracking-wide uppercase">
              Usage notes
            </h3>
            <ul class="text-text-muted mt-2 flex flex-col gap-1.5 text-sm">
              {app.usageNotes.map((note) => (
                <li class="flex gap-2">
                  <span aria-hidden="true">•</span>
                  {note}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        app.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {app.tags.map((tag) => (
              <span class="bg-bg-sunken text-text-muted rounded-full px-2.5 py-1 text-xs">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {related.length > 0 && <RelatedApps apps={related} />}
    </div>
  </dialog>
</BaseLayout>

<style>
  .app-info-dialog {
    margin: auto;
  }
</style>
