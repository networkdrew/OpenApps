---
import type { AppMeta } from "@/lib/apps/schema";
import { getCategory } from "@/lib/apps/categories";
import { getRelatedApps } from "@/lib/apps/registry";
import BaseLayout from "./BaseLayout.astro";
import PrivacyBadge from "@/components/astro/PrivacyBadge.astro";
import RelatedApps from "@/components/astro/RelatedApps.astro";

interface Props {
  app: AppMeta;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { app, structuredData } = Astro.props;
const category = getCategory(app.categoryId);
const related = getRelatedApps(app);
---

<BaseLayout
  title={app.name}
  description={app.seo.description ?? app.shortDescription}
  path={`/apps/${app.slug}/`}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-text-muted mb-4 text-sm">
      <a href="/apps/" class="hover:text-text hover:underline">All apps</a>
      {
        category && (
          <>
            {" "}
            /{" "}
            <a
              href={`/categories/${category.id}/`}
              class="hover:text-text hover:underline"
            >
              {category.name}
            </a>
          </>
        )
      }
    </nav>

    <h1 class="text-text text-2xl font-bold sm:text-3xl">{app.name}</h1>

    <div class="text-text-muted mt-3 flex max-w-2xl flex-col gap-3">
      {app.description.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      app.replacesProducts.length > 0 && (
        <p class="text-text-muted mt-3 text-sm">
          A free alternative to{" "}
          <span class="text-text font-medium">
            {app.replacesProducts.join(", ")}
          </span>
          .
        </p>
      )
    }

    <div class="mt-4 max-w-xl">
      <PrivacyBadge
        privacy={app.privacy}
        offlineCapable={app.offlineCapable}
        offlineNotes={app.offlineNotes}
      />
    </div>

    <div class="border-border bg-bg-elevated mt-8 rounded-xl border p-4 sm:p-6">
      <slot />
    </div>

    {
      app.usageNotes.length > 0 && (
        <div class="mt-8">
          <h2 class="text-text-muted text-sm font-semibold tracking-wide uppercase">
            Usage notes
          </h2>
          <ul class="text-text-muted mt-2 flex flex-col gap-1.5 text-sm">
            {app.usageNotes.map((note) => (
              <li class="flex gap-2">
                <span aria-hidden="true">•</span>
                {note}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      app.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {app.tags.map((tag) => (
            <span class="bg-bg-sunken text-text-muted rounded-full px-2.5 py-1 text-xs">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-10">
      <RelatedApps apps={related} />
    </div>
  </div>
</BaseLayout>
