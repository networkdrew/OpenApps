---
import type { Privacy } from "@/lib/apps/schema";
import Icon from "./Icon.astro";

interface Props {
  privacy: Privacy;
  offlineCapable: boolean;
  offlineNotes?: string;
}

const { privacy, offlineCapable, offlineNotes } = Astro.props;

const STORAGE_LABELS: Record<Privacy["storageMode"], string> = {
  none: "Nothing is saved — your input only exists while this page is open.",
  "local-storage": "Saved in your browser's local storage.",
  "indexed-db": "Saved in your browser's local database (IndexedDB).",
  "local-files":
    "Saved only when you export it — nothing is kept automatically.",
};
---

<div class="flex flex-col gap-2">
  <div
    class:list={[
      "inline-flex items-start gap-2 rounded-md border px-3 py-2 text-sm",
      privacy.dataLeavesDevice
        ? "border-danger/30 bg-danger/10 text-danger"
        : "border-success/30 bg-success/10 text-success",
    ]}
  >
    <Icon
      name={privacy.dataLeavesDevice ? "triangle-alert" : "shield-check"}
      class="mt-0.5 h-4 w-4 shrink-0"
    />
    <span>
      {
        privacy.dataLeavesDevice
          ? "This app sends some data off your device — see the details below."
          : "Runs entirely in your browser — nothing you enter is sent anywhere."
      }
    </span>
  </div>
  <p class="text-text-muted flex items-start gap-2 text-sm">
    <Icon name="database" class="mt-0.5 h-4 w-4 shrink-0" />
    {STORAGE_LABELS[privacy.storageMode]}
  </p>
  <p class="text-text-muted text-sm">{privacy.details}</p>
  <p class="text-text-muted flex items-start gap-2 text-sm">
    <Icon
      name={offlineCapable ? "check" : "circle-x"}
      class="mt-0.5 h-4 w-4 shrink-0"
    />
    {
      offlineCapable
        ? (offlineNotes ?? "Works offline after your first visit.")
        : "Requires an internet connection to use."
    }
  </p>
</div>
